library(readxl)
library(dplyr)
library(openxlsx)
library(tidyr)
library(stringr)
library(writexl)
library(data.table)
library(tidyverse)
###################
# CARGA DE DATOS Y VECTORES
###################
load("Data/Data_origin_UNIZAR.RData")    # data_origin

data_BIS_origin <- data_origin
data_BIS <- data_BIS_origin[1:2206, ]
data_BIS <- data_BIS_origin[1:2206, ]

# ► Orden original de sectores tal como vienen en el Excel importado
sector_orden_original <- unique(as.character(data_BIS$Sector))
###################
# 1) PASO A FORMATO LARGO (BASE)
###################
Numerador_BISO_raw <- data_BIS %>%
  pivot_longer(
    cols = -c(Pais, Sector),
    names_to = "Pais_columna",
    values_to = "Valor"
  ) %>%
  relocate(Pais_columna, .after = Sector) %>%
  separate(
    col = Pais_columna,
    into = c("Pais_col", "Sector_col"),
    sep = "_",
    extra = "merge"
  ) %>%
  mutate(
    Pais = str_squish(as.character(Pais)),
    Sector = str_squish(as.character(Sector)),
    Pais_col = str_squish(as.character(Pais_col)),
    Sector_limpio = str_remove(Sector_col, "\\d+$")
  ) %>%
  select(-Sector_col)

###################
# 2) CÁLCULO TIPO EXCEL (SI.ERROR(...,0) y diagonal a 0)
###################
BISO_long <- Numerador_BISO_raw %>%
  group_by(Pais, Sector, Pais_col, Sector_limpio) %>%
  summarise(
    numerador = sum(Valor, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  group_by(Pais_col, Sector, Sector_limpio) %>%
  mutate(
    denominador = sum(numerador[Pais != Pais_col], na.rm = TRUE),
    share = if_else(
      Pais == Pais_col,
      0,
      if_else(denominador == 0 | is.na(denominador), 0, numerador / denominador)
    )
  ) %>%
  ungroup()

###################
# 3) VOLVER A ANCHO (FORMATO FINAL)
#    + ORDENAR COLUMNAS-SECTOR EN EL MISMO ORDEN QUE LOS SECTORES EN FILAS
###################

# ► Capturamos el orden de sectores tal como aparecen en las FILAS (antes de pivotar)
sector_orden_filas <- unique(as.character(BISO_long$Sector))

BISO <- BISO_long %>%
  select(Pais, Sector_Fila = Sector, Pais_col, Sector_limpio, share) %>%
  pivot_wider(names_from = Sector_limpio, values_from = share)

cols_id <- c("Pais", "Sector_Fila", "Pais_col")
cols_sector_actuales <- setdiff(names(BISO), cols_id)

# ► Intersección manteniendo el orden de las filas; extras al final
cols_sector_ordenadas <- intersect(sector_orden_original, cols_sector_actuales)
cols_sector_extras    <- setdiff(cols_sector_actuales, cols_sector_ordenadas)
cols_sector_final     <- c(cols_sector_ordenadas, sort(cols_sector_extras))
BISO <- BISO %>%
  select(all_of(cols_id), all_of(cols_sector_final))

###################
# 4) ORDEN Y FACTORES (PAÍSES Y SECTORES EN FILAS)
###################
if (exists("Country")) {
  Country_clean  <- as.character(Country)
  extras_pais    <- setdiff(unique(BISO$Pais), Country_clean)
  niveles_pais   <- c(Country_clean, extras_pais)
}
BISO <- BISO %>%
  mutate(Sector_Fila = factor(as.character(Sector_Fila),
                              levels = sector_orden_original))

# ► Usamos sector_orden_filas también para el factor de Sector_Fila
BISO <- BISO %>%
  mutate(Sector_Fila = factor(as.character(Sector_Fila),
                              levels = sector_orden_filas))

BISO <- BISO %>%
  arrange(Pais, Sector_Fila)

###################
# 5) SI.ERROR(...,0): CONVERTIR NA A 0 (solo numéricas)
###################
BISO <- BISO %>%
  mutate(across(where(is.numeric), ~ replace_na(., 0)))

# Comprobación
any(is.na(BISO))

###################
# 6) EXPORTAR
###################
writexl::write_xlsx(BISO, "./Base_Import_share_by_origin/BISO.xlsx")