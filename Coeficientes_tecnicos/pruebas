# Cargar la matriz original
library(readxl)
library(dplyr)

# Identificar todas las celdas negativas
datos<- read_excel("IO_unizar.xlsx")
data_origin<-as.data.frame(datos)
save(data_origin, file="Data/Data_origin_UNIZAR.RData")
datos_matrix <- as.matrix(datos)
datos_matrix <- apply(datos_matrix, 2, as.numeric)

# Encontrar negativos
neg_positions <- which(datos_matrix < 0, arr.ind = TRUE)

cat("Total de valores negativos:", nrow(neg_positions), "\n")
cat("Fila | Columna | Valor\n")
for (i in seq_len(nrow(neg_positions))) {
  cat(sprintf("Fila %d | Col %d | Valor: %.6f\n",
              neg_positions[i, 1],
              neg_positions[i, 2],
              datos_matrix[neg_positions[i, 1], neg_positions[i, 2]]))
}